@* Toolbar icons. Drawing-tool icons are the desktop app's vector paths (filled); the rest are simple stroked outlines. *@
@if (Filled.TryGetValue(Name, out var filled))
{
    <svg class="icon" viewBox="0 0 21 21" aria-hidden="true">
        <path d="@filled.Path" fill="currentColor" stroke="@(filled.Stroke ? "currentColor" : "none")" stroke-width="1" />
    </svg>
}
else
{
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"
         stroke-linecap="round" stroke-linejoin="round">
        <path d="@Outlined.GetValueOrDefault(Name, "")" />
    </svg>
}

