<Window x:Class="FurnitureDesigner.App.Views.TemplateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Insert" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=WidthBox}">
    <StackPanel Margin="14" Width="300">
        <TextBlock Text="{Binding TemplateName}" Style="{StaticResource Header}" Margin="0,0,0,8" />

        <DockPanel Style="{StaticResource Field}">
            <TextBlock Text="Width (X)" Style="{StaticResource FieldLabel}" Width="120" />
            <TextBox x:Name="WidthBox" Text="{Binding Width}" />
        </DockPanel>
        <DockPanel Style="{StaticResource Field}">
            <TextBlock Text="Height (Y)" Style="{StaticResource FieldLabel}" Width="120" />
            <TextBox Text="{Binding Height}" />
        </DockPanel>
        <DockPanel Style="{StaticResource Field}">
            <TextBlock Text="Depth (Z)" Style="{StaticResource FieldLabel}" Width="120" />
            <TextBox Text="{Binding Depth}" />
        </DockPanel>
        <DockPanel Style="{StaticResource Field}">
            <TextBlock Text="Elevation" Style="{StaticResource FieldLabel}" Width="120" />
            <TextBox Text="{Binding Elevation}" />
        </DockPanel>
        <DockPanel Style="{StaticResource Field}">
            <TextBlock Text="{Binding MaterialLabel}" Style="{StaticResource FieldLabel}" Width="120" />
            <ComboBox ItemsSource="{Binding Materials}" DisplayMemberPath="Name" SelectedValuePath="Id"
                      SelectedValue="{Binding CarcassMaterialId}" />
        </DockPanel>

        <StackPanel Visibility="{Binding IsCabinet, Converter={StaticResource BoolToVis}}">
            <DockPanel Style="{StaticResource Field}">
                <TextBlock Text="Board thickness" Style="{StaticResource FieldLabel}" Width="120" />
                <TextBox Text="{Binding Thickness}" />
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
                <TextBlock Text="Plinth height" Style="{StaticResource FieldLabel}" Width="120" />
                <TextBox Text="{Binding Plinth}" />
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
                <TextBlock Text="Shelves" Style="{StaticResource FieldLabel}" Width="120" />
                <TextBox Text="{Binding Shelves}" />
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
                <TextBlock Text="Doors" Style="{StaticResource FieldLabel}" Width="120" />
                <TextBox Text="{Binding Doors}" />
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
                <TextBlock Text="Drawers" Style="{StaticResource FieldLabel}" Width="120" />
                <TextBox Text="{Binding Drawers}" ToolTip="Drawers replace the doors" />
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
                <TextBlock Text="Front material" Style="{StaticResource FieldLabel}" Width="120" />
                <ComboBox ItemsSource="{Binding Materials}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding FrontMaterialId}" />
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
                <TextBlock Text="Front style" Style="{StaticResource FieldLabel}" Width="120" />
                <ComboBox ItemsSource="{Binding FrontStyles}" SelectedItem="{Binding FrontStyle}" />
            </DockPanel>
            <DockPanel Style="{StaticResource Field}">
                <TextBlock Text="Back material" Style="{StaticResource FieldLabel}" Width="120" />
                <ComboBox ItemsSource="{Binding Materials}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding BackMaterialId}" />
            </DockPanel>
        </StackPanel>

        <TextBlock Text="All sizes in millimetres." Foreground="Gray" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OkButton" Content="Insert" Width="80" IsDefault="True" Click="OnOk" Margin="0,0,8,0" />
            <Button Content="Cancel" Width="80" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
