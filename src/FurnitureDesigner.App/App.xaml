<Application x:Class="FurnitureDesigner.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FurnitureDesigner.App.ViewModels"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <vm:EnumEqualsConverter x:Key="EnumEquals" />
        <vm:MaterialSwatchConverter x:Key="Swatch" />
        <vm:NullToCollapsedConverter x:Key="NullToCollapsed" />

        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="80" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Field" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,2" />
        </Style>

        <!-- Toolbar icons: Windows' built-in icon font, or vector paths for drawing tools. -->
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="20" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ViewLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Width" Value="20" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PathIcon" TargetType="Path">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="#FF3A4048" />
        </Style>

        <Geometry x:Key="IconCursor">M3,1 L3,17 L7,13 L10,19 L12.5,18 L9.5,12 L15,12 Z</Geometry>
        <Geometry x:Key="IconPaint">M8,2 L16,10 L10,16 C9,17 8,17 7,16 L2,11 C1,10 1,9 2,8 Z M5,9 L13,9 L8,4 Z M17,12 C17,12 19.5,15.5 19.5,17 C19.5,18.4 18.4,19.5 17,19.5 C15.6,19.5 14.5,18.4 14.5,17 C14.5,15.5 17,12 17,12 Z</Geometry>
        <Geometry x:Key="IconEyedropper">M15.5,1.5 C16.5,0.5 18.5,0.5 19.5,1.5 C20.5,2.5 20.5,4.5 19.5,5.5 L17,8 L18,9 L16.5,10.5 L10.5,4.5 L12,3 L13,4 Z M10,6 L15,11 L6.5,19.5 L3,20 L1.5,18.5 L2,15 Z</Geometry>
        <Geometry x:Key="IconRuler">M1,14 L14,1 L20,7 L7,20 Z M5,13 L6.5,14.5 M8,10 L10.5,12.5 M11,7 L12.5,8.5 M14,4 L16.5,6.5</Geometry>
        <Geometry x:Key="IconAlignLeft">M1,1 H3 V19 H1 Z M4,4 H17 V8 H4 Z M4,11 H12 V15 H4 Z</Geometry>
        <Geometry x:Key="IconAlignRight">M17,1 H19 V19 H17 Z M3,4 H16 V8 H3 Z M8,11 H16 V15 H8 Z</Geometry>
        <Geometry x:Key="IconAlignTop">M1,1 H19 V3 H1 Z M4,4 H8 V17 H4 Z M11,4 H15 V12 H11 Z</Geometry>
        <Geometry x:Key="IconAlignBottom">M1,17 H19 V19 H1 Z M4,3 H8 V16 H4 Z M11,8 H15 V16 H11 Z</Geometry>
        <Geometry x:Key="IconAlignBack">M1,1 H19 V3 H1 Z M3,5 H17 L15,9 H5 Z M5,11 H15 V17 H5 Z</Geometry>
        <Geometry x:Key="IconAlignFront">M1,17 H19 V19 H1 Z M5,3 H15 V9 H5 Z M5,11 H15 L17,15 H3 Z</Geometry>
        <Geometry x:Key="IconToWall">M1,1 H19 V4 H1 Z M3,1 L5,4 M7,1 L9,4 M11,1 L13,4 M15,1 L17,4 M6,8 H14 V18 H6 Z M10,5 L13,8 H7 Z</Geometry>
        <Geometry x:Key="IconToFloor">M1,16 H19 V19 H1 Z M6,2 H14 V10 H6 Z M10,15 L7,12 H13 Z</Geometry>
    </Application.Resources>
</Application>
